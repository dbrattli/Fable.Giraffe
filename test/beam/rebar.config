%% rebar config for the BEAM behavioral test suite. Adds the cowboy dep so the fake Cowboy
%% Req map can be read via cowboy_req:method/path/scheme, plus jsx (used by the Json backend).
{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.12.0"},
    jsx
]}.

{project_app_dirs, [".", "fable_modules/*"]}.
